APP_NAME=A2UI Backend
VERSION=0.1.0
API_PREFIX=/api
DEBUG=false
CORS_ORIGINS=["http://localhost:4200"]

# --- Banco de dados ---
# SQLite em arquivo (caminho relativo ao diretório apps/backend).
# O mesmo valor é usado pela app e pelo Alembic.
DATABASE_URL=sqlite:///./a2ui.db

# --- LLM provider ---
# Provedor: openai | anthropic
LLM_PROVIDER=openai
# Chave de API do provedor LLM (NUNCA commitar a chave real)
LLM_API_KEY=your-llm-api-key-here
# Modelo (ex.: gpt-4o-mini para openai, claude-3-5-sonnet-latest para anthropic)
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024

# --- WeatherAPI.com ---
# Registre-se em https://www.weatherapi.com/my/ para obter a chave.
# Integração opcional (NUNCA commitar a chave real).
WEATHER_API_KEY=your-weatherapi-key-here
WEATHER_BASE_URL=https://api.weatherapi.com/v1
