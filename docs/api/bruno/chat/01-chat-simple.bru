meta {
  name: POST Chat — mensagem simples
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/chat
  body: json
  auth: none
}

headers {
  Accept: text/event-stream
}

body:json {
  {
    "messages": [
      {
        "role": "user",
        "content": "Olá! Como você pode me ajudar?"
      }
    ]
  }
}
